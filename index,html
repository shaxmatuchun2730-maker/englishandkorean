<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lang Learning Mini App</title>
    <!-- Telegram WebApp scripti (Majburiy) -->
    <script src="https://telegram.org"></script>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="app-container">
        
        <!-- Header: Profil va Streak -->
        <header class="app-header">
            <div class="user-info">
                👤 <span id="username">O'quvchi</span>
            </div>
            <div class="streak-badge">
                🔥 <span id="streak-count">5</span> kun
            </div>
        </header>

        <!--🎯 Today's Goal -->
        <section class="todays-goal">
            <h3>🎯 TODAY'S GOAL</h3>
            <div class="goal-item">📘 Grammar: <strong id="today-grammar">Present Perfect</strong></div>
            <div class="goal-item">📝 Vocab: <strong id="today-vocab">5 ta yangi so'z</strong></div>
        </section>

        <!-- 🗂️ Asosiy 4 ta katakli bo'limlar -->
        <main class="main-menu">
            <div class="menu-grid">
                <div class="grid-card" onclick="openSection('grammar')">
                    <span class="card-icon">📘</span>
                    <h3>Grammar Hub</h3>
                </div>
                <div class="grid-card" onclick="openSection('vocab')">
                    <span class="card-icon">📝</span>
                    <h3>Vocab Box</h3>
                </div>
                <div class="grid-card" onclick="openSection('saved')">
                    <span class="card-icon">⭐️</span>
                    <h3>Saqlanganlar</h3>
                </div>
                <div class="grid-card" onclick="openSection('ai')">
                    <span class="card-icon">🤖</span>
                    <h3>AI Teacher</h3>
                </div>
            </div>
        </main>

        <!-- 📈 IELTS / TOPIK Pastki qulfli banner -->
        <footer class="app-footer">
            <div class="track-banner" onclick="openTrailer()">
                <span id="track-text">📈 IELTS Track (Tez kunda...)</span>
            </div>
        </footer>

    </div>

    <script src="script.js"></script>
</body>
</html>
